{
  "name": "fivem-frameworks",
  "displayName": "FiveM Frameworks IntelliSense",
  "description": "Autocomplete, hover docs, formatting and client/server checking for QBCore, Qbox, ESX, ox_lib, ox_inventory and the qb-* resources. Ships with FiveM natives.",
  "version": "0.1.0",
  "publisher": "Ryanathlawi",
  "author": {
    "name": "Athlawi",
    "url": "https://athlawi.vercel.app/"
  },
  "license": "MIT",
  "icon": "icon.png",
  "galleryBanner": {
    "color": "#4C1D95",
    "theme": "dark"
  },
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Programming Languages",
    "Linters",
    "Formatters"
  ],
  "keywords": [
    "fivem",
    "fxserver",
    "cfx",
    "qbcore",
    "qbox",
    "esx",
    "ox_lib",
    "ox_inventory",
    "qb-target",
    "lua",
    "gta5",
    "roleplay"
  ],
  "extensionDependencies": [
    "sumneko.lua"
  ],
  "extensionPack": [
    "overextended.cfxlua-vscode"
  ],
  "main": "./extension.js",
  "activationEvents": [
    "workspaceContains:**/fxmanifest.lua",
    "workspaceContains:**/__resource.lua"
  ],
  "contributes": {
    "configuration": {
      "title": "FiveM Frameworks",
      "properties": {
        "fivemFrameworks.frameworks": {
          "type": "array",
          "default": [
            "auto"
          ],
          "items": {
            "type": "string",
            "enum": [
              "auto",
              "qbcore",
              "qbx",
              "esx",
              "ox_lib",
              "ox_inventory",
              "qb_target",
              "qb_menu",
              "qb_inventory"
            ],
            "enumDescriptions": [
              "Detect from the resources in this workspace",
              "QBCore (qb-core)",
              "Qbox (qbx_core)",
              "ESX (es_extended)",
              "ox_lib",
              "ox_inventory",
              "qb-target",
              "qb-menu",
              "qb-inventory"
            ]
          },
          "markdownDescription": "Which definitions to load. `auto` looks for each resource folder in the workspace and falls back to loading all of them."
        },
        "fivemFrameworks.checkSide": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "Warn when a server-only function is called from a client file, or the reverse. The file's side comes from the resource`s `fxmanifest.lua`, falling back to folder and file naming."
        }
      }
    },
    "configurationDefaults": {
      "[lua]": {
        "editor.defaultFormatter": "sumneko.lua",
        "editor.tabSize": 4,
        "editor.insertSpaces": true
      }
    },
    "commands": [
      {
        "command": "fivemFrameworks.reload",
        "title": "FiveM: Reload framework definitions",
        "category": "FiveM"
      }
    ]
  },
  "scripts": {
    "generate": "node tools/generate.js",
    "test": "node tools/check.js && node tools/test-sides.js",
    "package": "vsce package",
    "publish": "vsce publish"
  },
  "devDependencies": {
    "@vscode/vsce": "^3.2.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Ryanathlawi/fivem-frameworks.git"
  },
  "homepage": "https://athlawi.vercel.app/",
  "bugs": {
    "url": "https://github.com/Ryanathlawi/fivem-frameworks/issues"
  }
}
